<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove(Directory.Packages.props, $(MSBuildThisFileDirectory)..))" />
  <PropertyGroup>
    <TestcontainersVersion>[4.14.0,)</TestcontainersVersion>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Closed at the next minor rather than left open like the rest of the
         repository: BenchmarkDotNet is pre-1.0, so the minor is its breaking
         segment, and an open upper bound would claim a compatibility that has
         not been established. Restore resolves either form to the lower bound;
         what differs is what the range says. -->
    <PackageVersion Include="BenchmarkDotNet" Version="[0.15.8,0.16.0)" />
    <!-- Transitive of Testcontainers; pinned above the vulnerable 2025.1.0 (GHSA-q939-rpr3-3284). -->
    <PackageVersion Include="SSH.NET" Version="[2026.0.0,)" />
    <PackageVersion Include="Testcontainers.MsSql" Version="$(TestcontainersVersion)" />
  </ItemGroup>
</Project>
